# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Shared ai-platform-db-v2 — async driver (postgresql+asyncpg://) is required.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres?ssl=require
ALEMBIC_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

AWS_REGION=eu-central-1
